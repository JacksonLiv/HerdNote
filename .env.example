# Copy to .env and adjust. NEVER commit the real .env.

# --- Postgres ---
POSTGRES_USER=cyberherd
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=pentestreportmaker

# --- Backend ---
# Async SQLAlchemy URL. Host "db" is the compose service name.
DATABASE_URL=postgresql+asyncpg://cyberherd:change-me-in-prod@db:5432/pentestreportmaker

# Signs session cookies. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-long-random-string

# Encrypts credential/compromised-user secrets at rest (AES-GCM).
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
# Rotating this makes existing encrypted secrets unreadable — see README.
APP_SECRET_KEY=replace-with-long-random-string

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8080

# Where uploaded evidence files are stored inside the api container.
EVIDENCE_DIR=/data/evidence
